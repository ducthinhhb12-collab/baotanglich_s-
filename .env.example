# =============================================================================
# CẤU HÌNH API AI CHO HƯỚNG DẪN VIÊN BẢO TÀNG LỊCH SỬ SỐ (1954 - 1975)
# Lưu ý: Sao chép file này thành .env và điền khóa API thật của bạn.
# Tuyệt đối KHÔNG chia sẻ hoặc đưa file .env có chứa khóa thật lên Git/kho lưu trữ!
# =============================================================================

# Nhà cung cấp AI (Lựa chọn: gemini HOẶC openai)
AI_PROVIDER=gemini

# Khóa API của nhà cung cấp AI (Google AI Studio hoặc OpenAI)
# Lấy khóa miễn phí từ Google: https://aistudio.google.com/app/apikey
AI_API_KEY=your_gemini_api_key_here

# Mô hình ngôn ngữ AI (Mặc định: gemini-4-argon hoặc gemini-3.8-flash hoặc gpt-4o-mini)
AI_MODEL=gemini-4-argon

# Cấu hình giọng đọc TTS tùy chọn (Lựa chọn: browser HOẶC openai HOẶC elevenlabs)
# Mặc định 'browser' sử dụng giọng đọc Tiếng Việt có sẵn của trình duyệt (Hoàn toàn miễn phí, không cần key)
TTS_PROVIDER=browser
TTS_API_KEY=
TTS_MODEL=

# Cổng khởi chạy máy chủ backend API (Mặc định: 3000 cho Vite hoặc 8080 cho server độc lập)
PORT=3000
